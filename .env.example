# Copy to .env.local (gitignored) and fill in.

# Assistant model: ollama | claude | leave empty for the scripted demo assistant.
# Opt-in: an ANTHROPIC_API_KEY alone does not turn Claude on.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b   # 16 GB Mac: 4b (3.3 GB) or 9b (6.6 GB, better). Needs Ollama 0.31.2+.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Postgres 18. The app connects as bv_app; migrations run as bv_owner.
# On Neon: DATABASE_URL is the -pooler host, DATABASE_OWNER_URL the direct host.
DATABASE_URL=postgres://bv_app:PASSWORD@localhost:5432/bonvoyage
DATABASE_OWNER_URL=postgres://bv_owner:PASSWORD@localhost:5432/bonvoyage
TEST_DATABASE_URL=postgres://bv_app:PASSWORD@localhost:5432/bonvoyage_test
TEST_DATABASE_OWNER_URL=postgres://bv_owner:PASSWORD@localhost:5432/bonvoyage_test

# Health-data encryption key: openssl rand -base64 32
DATA_KEY=

# Sign-in (Better Auth): BETTER_AUTH_SECRET from openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Price-watch job: openssl rand -hex 32
CRON_SECRET=
