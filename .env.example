# Copy to .env.local (gitignored) and fill in.

# Assistant model: ollama | claude | leave empty for the scripted demo assistant.
# Opt-in: an ANTHROPIC_API_KEY alone does not turn Claude on.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b   # 16 GB Mac: 4b (3.3 GB) or 9b (6.6 GB, better). Needs Ollama 0.31.2+.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Postgres 18. The app connects as bv_app; migrations run as bv_owner.
# On Neon: DATABASE_URL is the -pooler host, DATABASE_OWNER_URL the direct host.
DATABASE_URL=postgres://bv_app:PASSWORD@localhost:5432/bonvoyage
DATABASE_OWNER_URL=postgres://bv_owner:PASSWORD@localhost:5432/bonvoyage
TEST_DATABASE_URL=postgres://bv_app:PASSWORD@localhost:5432/bonvoyage_test
TEST_DATABASE_OWNER_URL=postgres://bv_owner:PASSWORD@localhost:5432/bonvoyage_test

# Health-data encryption key: openssl rand -base64 32
DATA_KEY=

# Sign-in (Better Auth): BETTER_AUTH_SECRET from openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Prototype remains closed to real health intake until regional review and activation.
REAL_PATIENT_DATA_ENABLED=false
# Studio requires a developer role plus explicit local/protected-preview opt-in.
DEV_STUDIO_ENABLED=false

# Public catalogue canonical origin. Leave blank locally; indexing requires a valid public HTTPS origin
# in production and verified, substantive content. Sample listings always remain noindex.
NEXT_PUBLIC_SITE_URL=

# Price-watch job: openssl rand -hex 32
CRON_SECRET=

# Flight provider: blank uses samples; test tokens use Duffel test mode.
DUFFEL_ACCESS_TOKEN=
DUFFEL_WEBHOOK_SECRET=
# Keep false until the phase 9 operational and legal gates are complete.
DUFFEL_LIVE_ENABLED=false
DUFFEL_BOOKING_ENABLED=false

# Stays uses clearly labelled samples unless test access is explicitly enabled.
DUFFEL_STAYS_ENABLED=false
# Local demo only: restart with e.g. 0.8 to exercise falling mock prices.
MOCK_FLIGHT_PRICE_FACTOR=1
# Verified sender and production operational alerts.
RESEND_API_KEY=
RESEND_FROM=
AUDIT_ALERT_EMAIL=
# HTTPS append-only gateway, administered separately from the database.
AUDIT_ANCHOR_URL=
AUDIT_ANCHOR_TOKEN=
# Operator acknowledgement is not legal certification; live booking is still blocked in code.
LIVE_RELEASE_APPROVED=false
